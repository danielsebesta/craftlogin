generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  uuid            String         @id @db.Uuid
  username        String         @db.VarChar(16)
  firstVerifiedAt DateTime       @default(now()) @db.Timestamptz(3)
  lastVerifiedAt  DateTime       @db.Timestamptz(3)
  refreshTokens   RefreshToken[]
}

model App {
  id                      String         @id @default(uuid()) @db.Uuid
  clientId                String         @unique @db.VarChar(64)
  clientSecretHash        String?        @db.VarChar(255)
  name                    String         @db.VarChar(100)
  redirectUris            String[]
  createdAt               DateTime       @default(now()) @db.Timestamptz(3)
  ownerUuid               String?        @db.Uuid
  owner                   Developer?     @relation(fields: [ownerUuid], references: [uuid], onDelete: SetNull)
  refreshTokens           RefreshToken[]
  verificationNote        String?        @db.VarChar(500)
  verificationRequestedAt DateTime?      @db.Timestamptz(3)
  verifiedAt              DateTime?      @db.Timestamptz(3)

  @@index([ownerUuid, createdAt])
}

enum DeveloperRole {
  DEVELOPER
  ADMIN
}

model Developer {
  uuid       String        @id @db.Uuid
  role       DeveloperRole @default(DEVELOPER)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  verifiedAt DateTime?     @db.Timestamptz(3)
  apps       App[]
}

model RefreshToken {
  tokenHash      String    @id @db.VarChar(64)
  clientId       String    @db.VarChar(64)
  userUuid       String    @db.Uuid
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  grantIdHash    String?   @db.VarChar(64)
  adapterPayload Json
  app            App       @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user           User      @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([userUuid, expiresAt])
  @@index([grantIdHash])
}
