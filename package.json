{
  "name": "craftlogin",
  "version": "0.1.0",
  "description": "A FOSS OAuth 2.0 and OpenID Connect identity provider for Minecraft Java Edition accounts.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "mysql2": "3.24.3",
    "uuid": "11.1.1"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "admin:grant": "tsx --env-file-if-exists=.env src/admin/grant-admin.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run db:validate && npm run openapi:check && npm test",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "format": "prettier --write . && prisma format",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:api": "tsx watch --env-file-if-exists=.env src/api/main.ts",
    "dev:mc": "tsx watch --env-file-if-exists=.env src/mc-server/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "start:mc": "tsx --env-file-if-exists=.env src/mc-server/main.ts",
    "start:api": "tsx --env-file-if-exists=.env src/api/main.ts",
    "start:production": "node dist/main.js",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:integration:postgres": "vitest run tests/integration/postgres-oidc-adapter.test.ts tests/integration/postgres-developer-access.test.ts tests/integration/postgres-identity-profile.test.ts",
    "test:integration:redis": "vitest run tests/integration/redis-verification-store.test.ts tests/integration/redis-skin-verification-store.test.ts tests/integration/redis-developer-session.test.ts tests/integration/redis-mojang-cache.test.ts tests/integration/redis-rate-limit.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/formbody": "9.0.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@napi-rs/canvas": "1.0.9",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "debug": "4.4.3",
    "dotenv": "17.4.2",
    "fastify": "5.12.3",
    "ioredis": "6.0.0",
    "minecraft-data": "3.116.0",
    "minecraft-protocol": "1.68.0",
    "oidc-provider": "9.12.2",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "prisma": "7.10.0",
    "prismarine-chunk": "1.41.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/debug": "4.1.12",
    "@types/node": "24.13.3",
    "@types/oidc-provider": "9.12.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
