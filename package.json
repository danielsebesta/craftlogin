{
  "name": "craftlogin",
  "version": "0.1.0",
  "description": "A FOSS OAuth 2.0 and OpenID Connect identity provider for Minecraft Java Edition accounts.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.6",
    "uuid": "14.0.3",
    "glob": "14.0.6",
    "minimatch": "11.0.8"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "admin:grant": "tsx --env-file-if-exists=.env src/admin/grant-admin.ts",
    "assets:generate": "tsx scripts/generate-assets.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run db:validate && npm run openapi:check && npm test",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "format": "prettier --write . && prisma format",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:api": "tsx watch --env-file-if-exists=.env src/api/main.ts",
    "dev:mc": "tsx watch --env-file-if-exists=.env src/mc-server/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "start:mc": "tsx --env-file-if-exists=.env src/mc-server/main.ts",
    "start:api": "tsx --env-file-if-exists=.env src/api/main.ts",
    "start:production": "node dist/main.js",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:integration:postgres": "vitest run tests/integration/postgres-oidc-adapter.test.ts tests/integration/postgres-app-icon.test.ts tests/integration/postgres-app-updates.test.ts tests/integration/postgres-app-verification.test.ts tests/integration/postgres-developer-access.test.ts tests/integration/postgres-identity-profile.test.ts",
    "test:integration:redis": "vitest run tests/integration/redis-oidc-adapter.test.ts tests/integration/redis-verification-store.test.ts tests/integration/redis-skin-verification-store.test.ts tests/integration/redis-developer-session.test.ts tests/integration/redis-mojang-cache.test.ts tests/integration/redis-rate-limit.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/formbody": "9.0.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.4",
    "@fastify/swagger-ui": "6.1.4",
    "@napi-rs/canvas": "1.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ajv": "8.20.0",
    "argon2": "0.45.2",
    "bowser": "2.15.0",
    "debug": "4.4.3",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "minecraft-data": "3.119.0",
    "minecraft-protocol": "1.68.0",
    "oidc-provider": "9.15.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prisma": "7.10.1",
    "prismarine-chunk": "1.41.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/debug": "4.1.13",
    "@types/node": "26.6.6",
    "@types/oidc-provider": "9.13.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "openapi-types": "12.1.3",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "argon2@0.45.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
