# Copy this file to .env and replace every empty required value before deployment.
# Never commit .env. Percent-encode special characters in DATABASE_URL credentials.

# Public origin used in OIDC metadata and redirects.
# Production requires HTTPS.
OIDC_ISSUER=https://craftlogin.com

# Two or more distinct comma-separated secrets, each at least 32 characters.
OIDC_COOKIE_KEYS=

# A single-line JSON Web Key Set containing at least one private signing key.
OIDC_JWKS=

# Use the same username, password, and database as the PostgreSQL values below.
DATABASE_URL=
REDIS_URL=redis://redis:6379

# Wildcard DNS for *.MC_BASE_DOMAIN must reach the host exposing MC_PUBLIC_PORT.
MC_BASE_DOMAIN=craftlogin.com

# Set true only when exactly one trusted reverse proxy is in front of CraftLogin.
HTTP_TRUST_PROXY=false
LOG_LEVEL=info

# Compose database configuration. POSTGRES_PASSWORD is required.
POSTGRES_DB=craftlogin
POSTGRES_USER=craftlogin
POSTGRES_PASSWORD=

# Public host ports. PostgreSQL and Redis bind to loopback only.
HTTP_PUBLIC_PORT=3000
MC_PUBLIC_PORT=25565
POSTGRES_PORT=5432
REDIS_PORT=6379

# Optional overrides for running the Node.js processes outside Compose.
NODE_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
MC_HOST=0.0.0.0
MC_PORT=25565

# Integration-test targets; tests refuse to run when the relevant value is absent.
TEST_DATABASE_URL=
TEST_REDIS_URL=redis://localhost:6379
