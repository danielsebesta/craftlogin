# Required in production
OIDC_ISSUER=https://craftlogin.com
OIDC_COOKIE_KEYS=
OIDC_JWKS=
DATABASE_URL=
REDIS_URL=redis://redis:6379
# Separate evictable image/profile cache; never point at the authentication Redis server.
CACHE_REDIS_URL=redis://redis-cache:6379
MC_BASE_DOMAIN=craftlogin.com
MICROSOFT_OAUTH_CLIENT_ID=
POSTGRES_PASSWORD=

# Optional Microsoft confidential-client credential
MICROSOFT_OAUTH_CLIENT_SECRET=

# Optional operator account: Minecraft name or UUID. Re-granted as admin on
# every boot, protected from demotion/removal, owns the seeded console client,
# and drives the landing-page avatar showcase.
DEVELOPER_OWNER=

# Runtime
NODE_ENV=production
LOG_LEVEL=info
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
HTTP_TRUST_PROXY=false
# Prefer explicit addresses/CIDRs of the actual immediate reverse proxies.
HTTP_TRUSTED_PROXIES=
# PostgreSQL connections per application process (sum across all replicas).
DATABASE_POOL_MAX=10
MC_HOST=0.0.0.0
MC_PORT=25565

# Docker Compose
POSTGRES_DB=craftlogin
POSTGRES_USER=craftlogin
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PUBLIC_PORT=3000
MC_PUBLIC_PORT=25565
POSTGRES_PORT=5432
REDIS_PORT=6379
CACHE_REDIS_PORT=6380
# Optional authentication Redis password; also include it in REDIS_URL.
REDIS_PASSWORD=

# Integration tests
TEST_DATABASE_URL=
TEST_REDIS_URL=redis://localhost:6379
