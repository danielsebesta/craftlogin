# Required in production
OIDC_ISSUER=https://craftlogin.com
OIDC_COOKIE_KEYS=
OIDC_JWKS=
DATABASE_URL=
REDIS_URL=redis://redis:6379
MC_BASE_DOMAIN=craftlogin.com
MICROSOFT_OAUTH_CLIENT_ID=
POSTGRES_PASSWORD=

# Optional Microsoft confidential-client credential
MICROSOFT_OAUTH_CLIENT_SECRET=

# Runtime
NODE_ENV=production
LOG_LEVEL=info
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
HTTP_TRUST_PROXY=false
MC_HOST=0.0.0.0
MC_PORT=25565

# Docker Compose
POSTGRES_DB=craftlogin
POSTGRES_USER=craftlogin
HTTP_PUBLIC_PORT=3000
MC_PUBLIC_PORT=25565
POSTGRES_PORT=5432
REDIS_PORT=6379

# Integration tests
TEST_DATABASE_URL=
TEST_REDIS_URL=redis://localhost:6379
